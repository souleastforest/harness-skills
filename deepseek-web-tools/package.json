{
  "name": "@local/dsh-deepseek-web-tools",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek 官方 Search / Fetch 接口的 ctx.web 提供方（专用检索端点），并保留旧后端作为自动回退。",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
